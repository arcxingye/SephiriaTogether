<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SephiriaTogether</AssemblyName>
    <AssemblyName Condition="'$(Loader)' == 'Workshop'">SephiriaTogether.Workshop</AssemblyName>
    <DefineConstants Condition="'$(Loader)' == 'Workshop'">$(DefineConstants);WORKSHOP</DefineConstants>
    <RootNamespace>SephiriaTogether</RootNamespace>
    <Version>3.10.1</Version>
    <GameDir Condition="'$(GameDir)' == '' and '$(SEPHIRIA_DIR)' != ''">$(SEPHIRIA_DIR)</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx" Condition="'$(Loader)' == 'BepInEx'">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath Condition="'$(Loader)' == 'BepInEx'">$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <HintPath Condition="'$(Loader)' == 'Workshop'">$(GameDir)\Sephiria_Data\Managed\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirror">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\Mirror.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirror.Components">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\Mirror.Components.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirror.Transports">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\Mirror.Transports.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Heathen.Steamworks">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\Heathen.Steamworks.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Heathen.Core">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\Heathen.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\UnityEngine.Physics2DModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateGameDir" BeforeTargets="ResolveReferences" Condition="'$(GameDir)' == ''">
    <Error Text="Set SEPHIRIA_DIR or pass -p:GameDir=&quot;path to Sephiria&quot;." />
  </Target>

  <Target Name="ValidateLoader" BeforeTargets="ResolveReferences">
    <Error Condition="'$(Loader)' != 'BepInEx' and '$(Loader)' != 'Workshop'" Text="Loader must be BepInEx or Workshop." />
    <Error Condition="'$(Loader)' == 'Workshop' and '$(DeployToGame)' == 'true'" Text="Use scripts/build-workshop.ps1 for a native Workshop package." />
  </Target>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true' and '$(Loader)' == 'BepInEx'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins" />
  </Target>
</Project>
